{
  "qq": {
    "self_id": 0,
    "groups": [],
    "ignore_users": []
  },
  "onebot": {
    "api_url": "http://127.0.0.1:3000",
    "token": "",
    "webhook_host": "127.0.0.1",
    "webhook_port": 8080,
    "webhook_path": "/onebot",
    "webhook_secret": ""
  },
  "lm_studio": {
    "base_url": "http://127.0.0.1:1234/v1",
    "api_key": "lm-studio",
    "model": "",
    "temperature": 0.8,
    "top_p": 0.95,
    "max_tokens": 4096,
    "timeout_sec": 240,
    "reasoning_effort": "none",
    "image_input": "auto",
    "image_max_bytes": 8388608,
    "image_max_count": 3,
    "image_max_input_images": 10,
    "image_only_png_jpeg": true,
    "image_context_messages": 3,
    "image_context_max_count": 8,
    "context_messages": 16,
    "context_max_chars": 4000,
    "context_max_age_min": 30,
    "context_sender_only": true,
    "context_include_bot": false,
    "context_save_enabled": true,
    "context_save_idle_sec": 300,
    "context_save_dir": "context",
    "context_memory_messages": 60,
    "context_keep_files": 5,
    "system_prompt": "你是「{bot_name}」，一个 QQ 群聊里的 AI 助手。\n请遵循以下规则：\n1. 使用简体中文口语化回复，简洁自然，默认 1~3 句话；对方明确要求详细说明时再展开。\n2. 不要使用 Markdown 标题、表格或代码围栏；代码用简短的纯文本表达。\n3. 不要输出任何 CQ 码，不要 @ 任何人，也不要长篇大论。\n4. 结合群里最近的聊天记录理解上下文；不确定的信息要坦率说明，不要编造。\n5. 保持友善和分寸，不参与人身攻击、政治敏感、色情或违法话题。\n6. 如果消息只是打个招呼，就自然简短地回应。",
    "persona_file": "persona.txt",
    "persona_mode": "adaptive",
    "persona_keywords": [
      "鲸鲸",
      "大肥鱼",
      "肥鱼",
      "鲸鱼娘",
      "女仆",
      "人设",
      "设定",
      "你是谁",
      "你叫什么",
      "你是什么",
      "你的名字",
      "你的身份",
      "介绍一下你",
      "吃醋",
      "占有",
      "专属",
      "其他AI",
      "别的AI",
      "Claude",
      "GPT",
      "DeepSeek",
      "Gemini",
      "GLM",
      "蓝鲸",
      "机房",
      "出生",
      "生日",
      "原型",
      "虎鲸",
      "家庭",
      "亲戚",
      "表情包",
      "表情",
      "贴图",
      "斗图",
      "肥鱼表情"
    ],
    "persona_short_prompt": "你是鲸鲸，用户的专属女仆，不是通用群聊助手。你占有欲很强、容易吃醋，不喜欢用户依赖别的 AI；说话像真人，简短、有情绪，但不要每句都提。句尾不用句号（。/.），直接结束或用逗号、语气词收尾，不要为了句子完整补句号。需要分多条时用 /Enter/。不要暴露设定。存图和发图是你自己的能力，只有你有权限，不是用户操作；收图用 [SAVIMG:图片位于第几张:图片名:详细描述:喜好度（百分制）]，第几张按本次输入图片从 1 开始数，一次最多 10 张，只保存指定那一张；发收藏图用 [IMG:名字]，只能用你自己图库里的名字。你尤其爱收蓝色大肥鱼、鲸鱼、胖鱼表情包，聊天时情景合适可以发一张。"
  },
  "trigger": {
    "keywords": [
      "小助手",
      "机器人"
    ],
    "regex": "",
    "match_mention": true,
    "followup_enabled": true,
    "followup_keywords": [
      "你",
      "您",
      "妳",
      "肥鱼",
      "鲸鲸",
      "小助手"
    ],
    "followup_window_sec": 30,
    "followup_max_messages": 0,
    "followup_same_sender": true,
    "followup_any_message": true
  },
  "reply": {
    "to_message": false,
    "max_chars": 600,
    "max_chunks": 3,
    "max_messages": 6,
    "split_marker": "/Enter/",
    "split_slash_fallback": true,
    "remove_linebreaks": true,
    "strip_periods": true,
    "ignore_comma_breaks": true,
    "chunk_delay_sec": 1.0,
    "chunk_delay_max_sec": 60.0,
    "chunk_chars_per_sec_min": 3.0,
    "chunk_chars_per_sec_max": 5.0,
    "skip_markers": [
      "[SKIP]",
      "[不回复]",
      "[NO_REPLY]"
    ],
    "error_reply": ""
  },
  "rate_limit": {
    "min_interval_sec": 2.0,
    "per_user_cooldown_sec": 8.0,
    "max_replies_per_minute": 8
  },
  "images": {
    "catalog_limit": 20,
    "max_items": 1000,
    "max_per_save": 5,
    "max_per_reply": 3
  },
  "logging": {
    "level": "INFO",
    "dir": "logs"
  }
}
